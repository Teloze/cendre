" cendre · soft · https://github.com/Aejkatappaja/cendre
" generated by scripts/extras.lua, do not edit
"
" Mirrors lua/lualine/themes/cendre.lua exactly:
"   one ground (bg2) for the whole bar; sections separate by ink weight;
"   mode badge is the only fill — same pigments as lualine's section a.
"
" Install: copy to ~/.vim/autoload/lightline/colorscheme/cendre-soft.vim then set:
"   let g:lightline = { 'colorscheme': 'cendre-soft' }

let s:bg0     = [ "#231f1d", 235 ]
let s:bg2     = [ "#37312e", 237 ]
let s:fg      = [ "#e6d5c2", 223 ]
let s:fg_dim  = [ "#a09384", 245 ]
let s:comment = [ "#73665b", 243 ]
let s:gutter  = [ "#4e4641", 240 ]
let s:ember   = [ "#ea9875", 209 ]
let s:ok      = [ "#43b16a", 71 ]
let s:info    = [ "#58bdff", 75 ]
let s:error   = [ "#d25780", 168 ]
let s:brass   = [ "#fcba81", 223 ]
let s:hint    = [ "#20c9cb", 37 ]
let s:warn    = [ "#f4a21c", 214 ]

let s:p = {'normal': {}, 'inactive': {}, 'insert': {}, 'replace': {}, 'visual': {}, 'command': {}, 'terminal': {}, 'tabline': {}}

let s:p.normal.left    = [ [ s:bg0,    s:ember ], [ s:fg,      s:bg2 ] ]
let s:p.normal.middle  = [ [ s:fg_dim, s:bg2   ] ]
let s:p.normal.right   = [ [ s:fg_dim, s:bg2   ], [ s:comment, s:bg2 ] ]
let s:p.normal.error   = [ [ s:bg0,    s:error  ] ]
let s:p.normal.warning = [ [ s:bg0,    s:warn   ] ]

let s:p.insert.left    = [ [ s:bg0,    s:ok    ], [ s:fg,      s:bg2 ] ]
let s:p.visual.left    = [ [ s:bg0,    s:info  ], [ s:fg,      s:bg2 ] ]
let s:p.replace.left   = [ [ s:bg0,    s:error ], [ s:fg,      s:bg2 ] ]
let s:p.command.left   = [ [ s:bg0,    s:brass ], [ s:fg,      s:bg2 ] ]
let s:p.terminal.left  = [ [ s:bg0,    s:hint  ], [ s:fg,      s:bg2 ] ]

let s:p.inactive.left   = [ [ s:gutter, s:bg2  ], [ s:gutter, s:bg2 ] ]
let s:p.inactive.middle = [ [ s:gutter, s:bg2  ] ]
let s:p.inactive.right  = [ [ s:gutter, s:bg2  ], [ s:gutter, s:bg2 ] ]

let s:p.tabline.left   = [ [ s:comment, s:bg2  ] ]
let s:p.tabline.tabsel = [ [ s:fg,      s:bg0  ] ]
let s:p.tabline.middle = [ [ s:comment, s:bg2  ] ]
let s:p.tabline.right  = copy(s:p.inactive.right)

let g:lightline#colorscheme#cendre_soft#palette = lightline#colorscheme#flatten(s:p)
